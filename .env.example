# Notion integration token (Notion -> Settings -> Connections -> Develop or manage integrations)
NOTION_API_KEY=

# Data source ID for the "Coaching Applications" Notion database
NOTION_DATABASE_ID=d9dbcdf8-6dce-4994-a50b-f8437c55a9fa

# Verified sender for outbound email (Brevo -> Senders, Domains & Dedicated IPs).
# Must be an address added and verified as a sender in Brevo, not just any address
# on a domain with SPF/DKIM configured.
EMAIL_FROM=JR Fitness <kuba@jrfitness.co.uk>

# Where new application notification emails are sent
NOTIFICATION_EMAIL=kuba@jrfitness.co.uk

# Brevo API key (Brevo -> Settings -> SMTP & API -> API Keys). Used for both the
# free-3-day-plan contact intake (submit-lead) and transactional application
# emails (submit-application).
BREVO_API_KEY=

# Brevo list ID that the "free 3-day plan" automation is triggered from
BREVO_LIST_ID=
